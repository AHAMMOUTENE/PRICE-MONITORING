# Connexion Postgres de Supabase : Project Settings > Database > Connection string (mode « Transaction pooler », port 6543).
DATABASE_URL=
# ScrapingBee (collecte des pages). Sans clé, les scans sont refusés.
SCRAPINGBEE_API_KEY=
# Facultatif : lecture des pages sans données structurées par Claude (clé API Anthropic).
ANTHROPIC_API_KEY=
EXTRACT_MODEL=claude-haiku-5-5
# Identité : derrière Cloudflare Access l'adresse vient de l'en-tête SSO. En local, simulez-la :
DEV_USER_EMAIL=
ADMIN_EMAILS=
# Droit par défaut d'un utilisateur sans accès explicite : editor | reader | none
DEFAULT_ZONE_ROLE=editor
# Réglages de collecte
SCAN_CONCURRENCY=4
SCAN_MAX_PAGES=8
PORT=8787
# E-mail de récapitulatif après chaque scan (désactivé tant que ces trois lignes ne sont pas renseignées).
# MAIL_FROM : adresse d'expédition autorisée chez Resend (domaine vérifié) ; APP_URL : adresse publique de l'application, pour les liens.
RESEND_API_KEY=
MAIL_FROM=
APP_URL=http://127.0.0.1:5173
# Réseau d'entreprise qui inspecte le trafic sécurisé : lancer Node avec NODE_USE_SYSTEM_CA=1 (npm run dev à la racine le fait déjà).

# Un seul hébergement : en production, HOST=0.0.0.0 ; le site (app/dist) est servi par ce même serveur.
HOST=127.0.0.1
STATIC_DIR=../app/dist

# Garde-fous contre l'emballement des coûts (valeurs par défaut ; SCANS_ENABLED=false coupe tout instantanément)
SCANS_ENABLED=true
MAX_CREDITS_PER_DAY=5000
MAX_CREDITS_PER_MONTH=60000
MAX_COST_USD_PER_DAY=10
MAX_CREDITS_PER_SITE=150
MAX_SCANS_PER_ZONE_PER_DAY=6
SCAN_COOLDOWN_MINUTES=30
SITE_COOLDOWN_HOURS=6
MAX_CONSECUTIVE_FAILURES=8
SCAN_MAX_MINUTES=20
MAX_FETCHES_PER_SCAN=2000
MAX_LLM_CALLS_PER_SCAN=20

# SSO simulé (développement uniquement) : page de connexion par e-mail. Refusé en production.
SSO_SIMULATED=true
